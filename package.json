{
  "name": "origen-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-version.js && vite build",
    "preview": "vite preview",
    "start": "vite preview --host --port ${PORT:-8080}",
