    "clsx": "^2.1.0",
    "framer-motion": "^12.26.2",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.0",
    "lucide-react": "^0.555.0",
    "matter-js": "^0.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "^5.5.6",
    "react-joyride": "^2.9.3",
