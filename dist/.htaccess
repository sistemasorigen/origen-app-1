<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Sin esto, index.html no tenía NINGÚN Cache-Control explícito: sin
  # encabezado el navegador cachea por heurística propia (RFC 7234),
  # pudiendo servir de memoria un index.html viejo que apunta a JS/CSS
  # con hash que ya no existe después de un deploy. Los archivos con
  # hash (/assets/*) no necesitan esto — su nombre cambia solo cuando
  # el contenido cambia, así que cachearlos fuerte es seguro y ya es
  # el comportamiento por default.
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
