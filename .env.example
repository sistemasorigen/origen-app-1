# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored and must NEVER be committed to the repository.

# Supabase — the anon key is safe to expose in client-side code (it is
# protected by Row-Level Security), but should still come from env vars.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Google Gemini — this key is a SECRET and must never appear in source code
# or in the compiled dist/ bundle.  Access it ONLY via import.meta.env.VITE_GEMINI_API_KEY
# inside source files.  The vite.config.ts define{} block must NOT be used
# to inline it.
VITE_GEMINI_API_KEY=<your-gemini-api-key>

# Service role key de Supabase — SOLO para scripts locales de Node
# (ej. scripts/notify-deploy.js), NUNCA con prefijo VITE_ (eso la
# incluiría en el bundle del cliente, exponiendo una key con
# privilegios totales sobre la base de datos).
# Conseguila en Supabase Dashboard → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>

# ── Publicación a producción (scripts/publish-dist.js) ──────────────────
# Credenciales FTP del hosting (DonWeb). Las usa "npm run deploy" para subir
# dist/ al server y después verificar contra la URL pública que el bundle
# servido sea el recién construido.
#
# Sin esto el deploy sólo llega hasta GitHub: entre el 24 y el 28 de agosto
# de 2026 producción quedó sirviendo un build viejo mientras cada deploy
# reportaba éxito, justamente porque no había ningún paso que publicara.
#
# Conseguilas en el panel de DonWeb → Cuentas FTP.
DEPLOY_FTP_HOST=<ftp.tudominio.com o la IP del servidor>
DEPLOY_FTP_USER=<usuario-ftp>
DEPLOY_FTP_PASSWORD=<contraseña-ftp>

# Carpeta que el dominio realmente sirve, dentro del FTP.
#
# OJO: NO es public_html a secas. El servidor tiene el repo clonado en
# public_html/app-origen/ y app.origeniglesia.org apunta a la subcarpeta
# dist/ de ese clone. Subir a la carpeta equivocada deja los archivos en un
# lugar que nadie sirve — el script lo detecta en la verificación y falla,
# pero mejor no perder el viaje.
DEPLOY_FTP_DIR=public_html/app-origen/dist

# URL pública contra la que se verifica el deploy.
DEPLOY_PUBLIC_URL=https://app.origeniglesia.org

# Sólo si el hosting no soporta FTPS y curl corta con un error de AUTH/TLS.
# Dejalo comentado salvo que haga falta: en claro la contraseña viaja sin cifrar.
# DEPLOY_FTP_PLAIN=true
