<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Sin esto, index.html no tenía NINGÚN Cache-Control explícito: sin
  # encabezado el navegador cachea por heurística propia (RFC 7234),
  # pudiendo servir de memoria un index.html viejo que apunta a JS/CSS
  # con hash que ya no existe después de un deploy. Los archivos con
  # hash (/assets/*) no necesitan esto — su nombre cambia solo cuando
  # el contenido cambia, así que cachearlos fuerte es seguro y ya es
  # el comportamiento por default.
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

# ── App instalable ─────────────────────────────────────────────────────
# El manifiesto con su tipo propio: sin esto Apache lo manda como
# text/plain (o, si faltara el archivo, el fallback de abajo devuelve
# index.html) y Chrome no lo toma como instalable.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # El manifiesto se revalida siempre: si cambia el nombre o un ícono, que
  # los teléfonos lo vean en la próxima visita y no en cuatro meses (el
  # hosting le pone 120 días de caché a todo lo estático por su cuenta).
  <FilesMatch "\.webmanifest$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  # El service worker de las notificaciones push se revalida SIEMPRE: si se
  # cachea, el navegador tarda en tomar una versión nueva (y el hosting le
  # pone 120 días a todo lo estático por su cuenta). Va además registrado
  # con updateViaCache: 'none'. Ver public/sw.js: no cachea nada.
  <FilesMatch "^sw\.js$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  # La caché larga de /iconos/ está en public/iconos/.htaccess: acá haría
  # falta un <If>, y en un Apache anterior a 2.4 eso tira 500 en todo el
  # sitio.
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
